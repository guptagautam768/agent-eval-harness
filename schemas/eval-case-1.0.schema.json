{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/guptagautam768/agent-eval-harness/schemas/eval-case-1.0.schema.json",
  "title": "Eval case 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "tags", "input", "expectations", "samples"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "caseId": { "type": "string", "pattern": "^[a-z0-9._-]+$" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "input": { "type": "object" },
    "expectations": { "type": ["object", "null"] },
    "samples": { "type": "integer", "minimum": 1 }
  }
}
