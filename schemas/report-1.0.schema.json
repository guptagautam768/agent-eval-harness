{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/guptagautam768/agent-eval-harness/schemas/report-1.0.schema.json",
  "title": "Report 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "summary", "results", "gate", "warnings", "environment", "configFingerprint"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "summary": { "type": "object" },
    "results": { "type": "array" },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "violations"],
      "properties": {
        "pass": { "type": "boolean" },
        "violations": { "type": "array" }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jdk", "os", "harnessVersion", "gitSha"],
      "properties": {
        "jdk": { "type": "string" },
        "os": { "type": "string" },
        "harnessVersion": { "type": "string" },
        "gitSha": { "type": ["string", "null"] }
      }
    },
    "configFingerprint": { "type": "string" }
  }
}
